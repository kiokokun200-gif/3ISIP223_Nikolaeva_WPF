<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._2MainGamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_2MainGamePage">

    <Grid>
        <Grid.Background>
            <ImageBrush x:Name="ImagBr" />
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>

        </Grid.ColumnDefinitions>


        <ProgressBar x:Name="ProgBarHp" Grid.Row="0" Grid.ColumnSpan="3" Height="25" Minimum="0" Maximum="100" 
                      Background="#FF3BCD37" />

        <TextBlock x:Name="TxtBlcCurrentHP" Grid.Row="0" Grid.ColumnSpan="3" HorizontalAlignment="Center"
                    FontSize="16" VerticalAlignment="Center" />

        <!--девочка с доспехами-->
        <Viewbox Grid.Column="0" Grid.Row="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Image Grid.Row="0" Grid.RowSpan="2" Source="/Images/player_1c_chan.png"  />
                <Image x:Name="ImgArmorOnPlayer" Grid.Row="0" Height="350" />
                <Image x:Name="ImgWeaponOnPlayer" Grid.Row="0" Width="300" HorizontalAlignment="Left"/>
            </Grid>
        </Viewbox>
        <TextBlock x:Name="TxtBlcFloor" Text="Этаж: " Grid.Column="0" Grid.Row="1" FontSize="28"/>
        
        <!--сундук-->
        <Image x:Name="ImgChest" Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Center" 
               VerticalAlignment="Center" Width="250" Visibility="Hidden"/>
        <!--картинка лута из сундука-->
        <Image x:Name="ImgLutfromChest" Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Center"
               VerticalAlignment="Center"  Width="100"/>

        
        <!--мобы и логи-->
        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="TxtBlcLogg" FontSize="40" Text="Съешь">
                <TextBlock.Effect>
                    <DropShadowEffect/>
                </TextBlock.Effect>
            </TextBlock>
            <ListBox Background="Transparent" x:Name="ListMobs" SelectionChanged="ListMobs_SelectionChanged"
                ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" >
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Images/Icons/IconHP.png" Width="30"/>
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}/{1} ХП">
                                            <Binding Path="MaxHP"/>
                                            <Binding Path="CurrentHP"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Images/Icons/IconATK.png" Width="30"/>
                                <TextBlock Text="{Binding Attack}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Images/Icons/IconDEF.png" Width="30"/>
                                <TextBlock Text="{Binding Defense}"/>
                            </StackPanel>
                            <Image x:Name="ImageCurrentMob" Source="{Binding DefaultImage}" Height="200"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </StackPanel>
            
        
        <!--оружие-->
        <StackPanel Orientation="Horizontal" Grid.Column="0" Grid.Row="3">
            <Border BorderBrush="#FF717171"  BorderThickness="5" Height="100" Width="100" >
                <Border.Background >
                    <SolidColorBrush Color="#FF1D1D1D" Opacity="0.55"/>
                </Border.Background>
            <Image x:Name="ImgWeapon" />
            </Border >
            <Border BorderBrush="#FF717171"  BorderThickness="5" Height="100" Width="100" >
                <Border.Background >
                    <SolidColorBrush Color="#FF1D1D1D" Opacity="0.55"/>
                </Border.Background>
                <Image x:Name="ImgArmor" />
            </Border >
        </StackPanel>
        
        <!--кнопки атаки и защиты-->
        <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="1"  HorizontalAlignment="Left">
            <Button x:Name="BtnAttack" Content="Атака" FontSize="30" Background="#FF828282" 
                    Height="60" Width="150" BorderBrush="Black" Margin="0 0 10 0" Click="BtnAttack_Click"/>
            
            <Button x:Name="BtnDefence" Content="Защита" FontSize="30" Background="#FF828282" Height="60" 
                    BorderBrush="Black" Width="150" Click="BtnDefence_Click"/>
        </StackPanel>
        <TextBlock x:Name="TxtBlcHint" Grid.Row="2" Grid.Column="1" 
           Text="Кликните на врага для атаки" 
           FontSize="20" Foreground="Gold" 
           HorizontalAlignment="Center" Margin="0,0,0,10"
           Visibility="Collapsed"/>
        
        <!--логи-->
        <StackPanel Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2">
            <TextBlock Text="L;FDS"/>
        </StackPanel>
        
        

    </Grid>
</Page>
