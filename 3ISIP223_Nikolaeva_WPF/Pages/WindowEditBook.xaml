<Window x:Class="_3ISIP223_Nikolaeva_WPF.Pages.WindowEditBook"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
        mc:Ignorable="d"
        Title="WindowEditBook" Height="650" Width="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Margin="10">
            <Image Source="{Binding CoverImage}" Width="300" Height="370"/>
            <TextBox x:Name="TxtBoxImagePath" Text="{Binding CoverImage}" Margin="0 10 0 10" Width="270"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="5">
            <TextBlock Text="Название: "/>
            <TextBox x:Name="TxtBoxName" Text="{Binding Name}" Margin="0 0 0 15" />

            <StackPanel Orientation="Horizontal">
                
               <TextBlock Text="Жанры:" Margin="0 0 10 0"/>
                <Button x:Name="BtnAddGenre" Content="Добавить жанр" Style="{StaticResource BtnsMenu }"/>
            </StackPanel>
            <ListBox x:Name="ListBoxGenres" d:ItemsSource="{d:SampleData ItemCount=5}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                                
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Genre.Name}"/>
                            <!--<Border Grid.Column="1" CornerRadius="50" Width="30"  HorizontalAlignment="Right" Height="30" BorderBrush="Gray" BorderThickness="1">-->
                            <Button x:Name="BtnDeleteGenre" Grid.Column="1"  Background="Transparent" BorderThickness="0" FontSize="10" Content="✕" Click="BtnDeleteGenre_Click"/>
                            <!--</Border>-->
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Описание: "/>
            <TextBox x:Name="TxtBoxDescription" Text="{Binding Description}" Margin="0 0 0 15" Width="250" Height="100" TextWrapping="Wrap"/>

            <TextBlock Text="Текст: "/>
            <TextBox x:Name="TxtBoxText" Text="{Binding Text}" Margin="0 0 0 15" Width="250" Height="180"/>


            <Button x:Name="BtnSave" Content="Сохранить" Style="{StaticResource BtnsPikmi}" Width="150" HorizontalAlignment="Left" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
