<Window x:Class="_3ISIP223_Nikolaeva_WPF.Pages.WindowAddManufacturer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
        mc:Ignorable="d"
        Title="WindowAddManufacturer" Height="150" Width="700">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal">
            <TextBlock Text="Введите название производителя" Margin="10"/>
            <TextBox x:Name="TxtBoxNameMan" FontSize="30"  Height="40" Width="200" Margin="0 0 10 0"/>
        </StackPanel>

        <Button Grid.Row="1" Name="BtnConfAddMan" Content="Добавить" Height="30" Width="300" Click="BtnConfAddMan_Click"/>


    </Grid>
</Window>
