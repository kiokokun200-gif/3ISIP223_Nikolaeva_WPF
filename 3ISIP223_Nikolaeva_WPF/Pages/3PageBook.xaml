<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._3PageBook"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_3PageBook">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        
        <Image Grid.Column="0" Source="{Binding CoverImage}" Width="300" Height="400" VerticalAlignment="Top"/>
        <StackPanel Grid.Column="1" HorizontalAlignment="Left">
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="30" FontWeight="Bold" Margin="0 0 0 10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1">
                    <Button x:Name="BtnComplaintBook" Content="🚩 Пожаловаться на книгу" HorizontalAlignment="Right" Background="White" BorderThickness="0" Margin="10 0 10 0" Click="BtnComplaintBook_Click"/>
                    <Button x:Name="BtnComplaintAuthor" Content="🚩 Пожаловаться на автора" HorizontalAlignment="Right" Background="White" BorderThickness="0" Click="BtnComplaintAuthor_Click"/>
                    <Button x:Name="BtnFrozeBook" Content="Заморозить" Style="{StaticResource BtnsMenu}" Visibility="Collapsed"  Margin="10 10 0 0" Click="BtnFrozeBook_Click"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding Description}" FontSize="22" Margin="0 0 0 10"/>
            <TextBlock Text="{Binding User.NickName, StringFormat=Автор: {0}}" FontSize="22" Margin="0 0 0 10"/>
            <TextBlock Text="{Binding Genres, StringFormat=Жанры: {0}}" FontSize="22" Margin="0 0 0 10"/>
            <Button x:Name="BtnAddToList" Content="Добавить в список" Background="#FFFF559B" Margin="0 0 0 10" Width="200" Height="40" BorderThickness="0" FontSize="15" HorizontalAlignment="Left" Click="BtnAddToList_Click"/>
            <Button x:Name="BtnSeeContentBook" Content="Посмотреть фрагмент ↓" Style="{StaticResource BtnsMenu}" Width="230" Height="35" Click="BtnSeeContentBook_Click"/>
            <TextBlock x:Name="TxtBlcSeeContent" Text="{Binding Text}" FontSize="20" Foreground="Gray" Visibility="Collapsed" TextWrapping="Wrap"/>
            <TextBlock Text="Отзывы: "/>
            <ListBox x:Name="ListBoxReview" d:ItemsSource="{d:SampleData ItemCount=5}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="{Binding User.NickName}"  FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Date, StringFormat=dd MMMM yyyy}" FontSize="14"/>
                                    
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right">
                                    <Button x:Name="BtnComplaintReview" Content="Жалоба ⚠" FontSize="10" Background="White" BorderThickness="0" Height="30" Click="BtnComplaintReview_Click"/>
                                    <TextBlock  HorizontalAlignment="Right" Text="{Binding Rating, StringFormat={}★{0}}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Text}"/>
                                
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</Page>
