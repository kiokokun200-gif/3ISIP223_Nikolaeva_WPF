<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._3PageBook"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_3PageBook">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0" Source="{Binding CoverImage}" Width="300" Height="400" VerticalAlignment="Top"/>
        <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Name}" FontSize="30" FontWeight="Bold" Margin="0 0 0 10"/>
            <TextBlock Text="{Binding Description}" FontSize="22" Margin="0 0 0 10"/>
            <TextBlock Text="{Binding User.NickName, StringFormat=Автор: {0}}" FontSize="22" Margin="0 0 0 10"/>
            <TextBlock Text="{Binding Genres, StringFormat=Жанры: {0}}" FontSize="22" Margin="0 0 0 10"/>
        </StackPanel>
    </Grid>
</Page>
