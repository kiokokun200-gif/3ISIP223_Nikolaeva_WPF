<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._3UserAsseblyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_3UserAsseblyPage">

    <Grid Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Ваши сборки" FontSize="25"/>
        <ListBox x:Name="AssemblyListBox" Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding name}" FontSize="20"/>
                        <ListBox x:Name="PartsAssemblyListBox" ItemsSource="{Binding partassembly}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding basepart.name}" FontSize="16"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button x:Name="BtnBack" Grid.Row="1" Content="Назад" HorizontalAlignment="Left" VerticalAlignment="Bottom" FontSize="20" Width="100" Height="30" Background="#FFFF3394" BorderThickness="0" Foreground="White" Click="BtnBack_Click"/>
    </Grid>
</Page>
