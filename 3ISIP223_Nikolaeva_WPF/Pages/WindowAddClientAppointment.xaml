<Window x:Class="_3ISIP223_Nikolaeva_WPF.Pages.WindowAddClientAppointment"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
        mc:Ignorable="d"
        Title="WindowAddClientAppointment" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Left" Orientation="Horizontal">
            <TextBlock  Text="⌕" FontSize="30" Margin="10"/>
            <TextBox x:Name="TxtBoxSearchUser" Width="250" Height="40" Margin="0 0 10 0" TextChanged="TxtBoxSearchUser_TextChanged"/>
        </StackPanel>

        <ListBox x:Name="ListBoxClients" Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightPink" BorderThickness="1" CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ФИО: " FontSize="22" Margin="10 0 0 10"/>
                                <TextBlock Text="Номер: " FontSize="22" Margin="10 0 0 0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <StackPanel  Orientation="Horizontal">
                                    <TextBlock Text="{Binding FirstName}" FontSize="22" Margin="0 0 3 10"/>
                                    <TextBlock Text="{Binding LastName}" FontSize="22" Margin="0 0 3 10"/>
                                    <TextBlock Text="{Binding MiddleName}" FontSize="22" Margin="0 0 20 10"/>
                                </StackPanel>
                                <TextBlock Text="{Binding PhoneNumber}" FontSize="22"/>
                            </StackPanel>
                            <Button Content="Подтвердить" Grid.Column="2" Height="40" Width="130" FontSize="20" Margin="0 0 10 0" Click="BtnConfirm_Click"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
