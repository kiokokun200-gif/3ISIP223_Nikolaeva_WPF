<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._2PageProfile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_2PageProfile">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Button x:Name="BtnBack" Content="Назад" Width="50" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="#FFFF37B5" Foreground="White" Click="BtnBack_Click"/>
        <StackPanel x:Name="StackProfile" Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="{Binding Email}" FontSize="20"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <TextBlock Text="Мои билеты:" FontSize="25"/>
            <ListBox x:Name="TicketKListBox">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{Binding Seans.Film.Name}" FontSize="20"/>
                            <TextBlock Text="{Binding Seans.SeansDate, StringFormat=Дата: {0:dd.MM}}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Seans.SeansDate, StringFormat=Время: {0:hh\\:mm}}" Margin="0,0,10,0"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding RowNumber, StringFormat=Ряд: {0}}" Margin="0 0 10 0"/>
                                <TextBlock Text="{Binding SeatNumber, StringFormat=Место: {0}}" Margin="0 0 10 0" />
                                <TextBlock Text="{Binding Price, StringFormat=Цена: {0}}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</Page>
