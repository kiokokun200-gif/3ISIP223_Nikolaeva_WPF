<Window x:Class="_3ISIP223_Nikolaeva_WPF.Pages.WindowChangeProduct"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Редактирование товара" Height="550" Width="800"
        WindowStartupLocation="CenterOwner">

    <Grid Background="White" Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Картинка -->
        <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <Image Source="{Binding Image}" Width="200" Height="200"/>
            <TextBlock Text="Путь к картинке:" FontSize="14" Margin="0,10,0,5"/>
            <TextBox x:Name="TxtBoxImage" Width="200" Height="30" FontSize="14"/>
        </StackPanel>

        <!-- Поля для редактирования -->
        <StackPanel Grid.Column="1">
            <TextBlock Text="Название:" FontSize="16" FontWeight="Bold"/>
            <TextBox x:Name="TxtBoxName" FontSize="16" Height="35" Margin="0,0,0,15"/>

            <TextBlock Text="Цена:" FontSize="16" FontWeight="Bold"/>
            <TextBox x:Name="TxtBoxCost" FontSize="16" Height="35" Margin="0,0,0,15"/>

            <TextBlock Text="Скидка (%):" FontSize="16" FontWeight="Bold"/>
            <TextBox x:Name="TxtBoxDiscount" FontSize="16" Height="35" Margin="0,0,0,15"/>

            <TextBlock Text="Категория:" FontSize="16" FontWeight="Bold"/>
            <ComboBox x:Name="ComboBoxCategory" FontSize="16" Height="35" Margin="0,0,0,15"
                      DisplayMemberPath="Name"/>

            <TextBlock Text="Производитель:" FontSize="16" FontWeight="Bold"/>
            <ComboBox x:Name="ComboBoxManufacturer" FontSize="16" Height="35" Margin="0,0,0,15"
                      DisplayMemberPath="Name"/>

            <TextBlock Text="Рейтинг:" FontSize="16" FontWeight="Bold"/>
            <TextBox x:Name="TxtBoxRating" FontSize="16" Height="35" Margin="0,0,0,15"/>

            <TextBlock Text="Описание:" FontSize="16" FontWeight="Bold"/>
            <TextBox x:Name="TxtBoxDescription" FontSize="16" Height="80" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Сохранить" Width="100" Height="35" Click="BtnSave_Click" Margin="0,0,10,0"/>
                <Button Content="Отмена" Width="100" Height="35" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>