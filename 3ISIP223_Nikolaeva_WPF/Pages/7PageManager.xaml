<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._7PageManager"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_7PageManager">

    <Grid Background="White">
        <TabControl>
            <!-- Вкладка ЗАПИСИ -->
            <TabItem Header="Записи" FontSize="22" x:Name="TabItemAppointment">
                <Grid>
                    <ListBox x:Name="ListBoxAppointments" Margin="5" d:ItemsSource="{d:SampleData ItemCount=5}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="LightPink" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Service.Name}" FontSize="22" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding User.FirstName, StringFormat=Клиент: {0} {1}}" FontSize="18"/>
                                            <TextBlock Text="{Binding Master.FirstName, StringFormat=Мастер: {0} {1}}" FontSize="18"/>
                                            <TextBlock Text="{Binding Date, StringFormat=Дата: {0:dd.MM.yyyy HH:mm}}" FontSize="16"/>
                                            <TextBlock Text="{Binding Comment, StringFormat=Комментарий: {0}}" FontSize="14" Foreground="Gray"/>
                                            <TextBlock Text="{Binding Status, StringFormat=Статус: {0}}" FontSize="14" Foreground="Blue"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10">
                                            <Button Content="Перенести" Visibility="{Binding VisIsClosed}" Width="200" Height="35" Margin="0,0,0,10" 
                                                Click="BtnChangeAppointment_Click" Tag="{Binding}"/>
                                            <Button Content="Отменить" Visibility="{Binding VisIsClosed}" Width="200" Height="35" 
                                                Click="BtnCancelAppointment_Click" Tag="{Binding}"/>
                                            <Button Content="Записать клиента" Width="200" Height="35" Margin="0,10,0,0" 
                                                Click="BtnAddClientAppointment_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- Вкладка ЗАКАЗЫ -->
            <TabItem Header="Заказы" FontSize="22">
                <ListBox x:Name="ListBoxOrders" Margin="5" d:ItemsSource="{d:SampleData ItemCount=5}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="LightPink" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding ID, StringFormat=Заказ №{0}}" FontSize="22" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Date, StringFormat=Дата заказа: {0:dd.MM.yyyy}}" FontSize="18"/>
                                        <TextBlock Text="{Binding DeliverDate, StringFormat=Дата получения: {0:dd.MM.yyyy}}" FontSize="18"/>
                                        <TextBlock Text="{Binding User.FirstName, StringFormat=Клиент: {0} {1}}" FontSize="18"/>
                                        <TextBlock Text="{Binding TotalAmount, StringFormat=Сумма: {0} Р}" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding IsClosed, StringFormat=Выдан: {0}}" FontSize="14" Foreground="Gray"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="Выдать заказ" Width="200" Height="35" 
                                        Visibility="{Binding VisIsClosed}" Margin="10 0 0 0"
                                        Click="BtnCloseOrder_Click" Tag="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <!-- Вкладка ТОВАРЫ -->
            <TabItem Header="Товары" FontSize="22">
                <ListBox x:Name="ListBoxProduct" Margin="5" d:ItemsSource="{d:SampleData ItemCount=5}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="LightPink" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0" Height="100" Width="100" Source="{Binding Image}" Margin="0,0,10,0"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding PriceWithDiscount, StringFormat=Цена со скидкой: {0} Р}" FontSize="16"/>
                                        <TextBlock Text="{Binding Discount, StringFormat=Скидка: {0}%}" FontSize="14"/>
                                        <TextBlock Text="{Binding Manufacturer.Name, StringFormat=Производитель: {0}}" FontSize="14"/>
                                        <TextBlock Text="{Binding ProdCategory.Name, StringFormat=Категория: {0}}" FontSize="14"/>
                                        <TextBlock Text="{Binding IsFrozen, StringFormat=Заморожен: {0}}" FontSize="14" Foreground="Red"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10">
                                        <Button Content="Изменить" Width="150" Height="35" Margin="0,0,0,10" 
                                            Click="BtnChangeProduct_Click" Tag="{Binding}"/>
                                        <Button Content="{Binding ButtonContenFrozen}" Width="150" Height="35" 
                                            Click="BtnFrozeProduct_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <!-- Вкладка ПРОИЗВОДИТЕЛИ -->
            <TabItem Header="Производители" FontSize="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="Добавить производителя" Width="300" Height="35" Margin="10" 
                        HorizontalAlignment="Left" Click="BtnAddManufacturer_Click"/>

                    <ListBox Grid.Row="1" x:Name="ListBoxManufacturers" Margin="5" d:ItemsSource="{d:SampleData ItemCount=5}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="LightPink" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="20"/>
                                        <Button Grid.Column="1" Content="Изменить" Width="150" Height="30" Margin="10 0 0 0"
                                            Click="BtnChangeMan_Click" Tag="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- Вкладка ТИПЫ ТОВАРОВ -->
            <TabItem Header="Типы товаров" FontSize="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="Добавить тип товара" Width="300" Height="35" Margin="10" 
                        HorizontalAlignment="Left" Click="BtnAddProdCat_Click"/>

                    <ListBox Grid.Row="1" x:Name="ListBoxProdCateg" Margin="5" d:ItemsSource="{d:SampleData ItemCount=5}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="LightPink" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="20"/>
                                        <Button Grid.Column="1" Content="Изменить" Width="150" Height="30" Margin="10 0 0 0"
                                            Click="BtnChangeProdCat_Click" Tag="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- Вкладка ТИПЫ УСЛУГ -->
            <TabItem Header="Типы услуг" FontSize="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="Добавить тип услуги" Width="300" Height="35" Margin="10" 
                        HorizontalAlignment="Left" Click="BtnAddServCat_Click"/>

                    <ListBox Grid.Row="1" x:Name="ListBoxServCat" Margin="5" d:ItemsSource="{d:SampleData ItemCount=5}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="LightPink" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="20"/>
                                        <Button Grid.Column="1" Content="Изменить" Margin="10 0 0 0" Width="150" Height="30" 
                                            Click="BtnChangeServCat_Click" Tag="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
