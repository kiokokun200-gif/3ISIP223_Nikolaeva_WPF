<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._7PageManager"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_7PageManager">

    <Grid Background="White">

        <TabControl>
            <TabItem Header="Записи" FontSize="22" x:Name="TabItemAppointment">
                <Grid>
                    <!--<Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Left" Orientation="Horizontal">
                        <TextBlock  Text="⌕" FontSize="30" Margin="10"/>
                        <TextBox x:Name="TxtBoxSearchUser" Width="150" Height="30" Margin="0 0 10 0"/>
                    </StackPanel>-->

                    <ListBox x:Name="ListBoxAppointments" d:ItemsSource="{d:SampleData ItemCount=5}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="LightPink" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Row="0" Margin="20">
                                            <TextBlock Text="{Binding Service.Name}" FontSize="28"/>
                                            <TextBlock Text="{Binding User.FirstName, StringFormat=Клиент: {0}}" FontSize="20"/>
                                            <TextBlock Text="{Binding User.FirstName, StringFormat=Мастер: {0}}" FontSize="20"/>
                                            <TextBlock Text="{Binding Date}" FontSize="20"/>
                                            <TextBlock Text="{Binding Schedule.StartTime}" FontSize="20"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" >
                                                <Button Content="Перенести запись" Height="30" Width="200" Margin="0 0 0 20" Click="BtnChangeAppointment_Click"/>
                                                <DatePicker Name="DatePickAppointment" SelectedDate="{Binding Date}" Height="40" Margin="10 0 10 20" Visibility="Collapsed"/>
                                                <Button x:Name="BtnConfirmChange" Content="Подтвердить" Margin="10 0 10 20" Height="30" Width="200" Visibility="Collapsed"/>
                                            </StackPanel>
                                            <Button Content="Отменить запись" Height="30" Width="200"  Margin="0 0 0 20" Click="BtnCancelAppointment_Click"/>
                                            <Button Content="Записать клиента" Height="30" Width="200" Click="BtnAddClientAppointment_Click"/>
                                        </StackPanel>
                                    </Grid>

                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="Заказы" FontSize="22">
                <ListBox x:Name="ListBoxOrders" d:ItemsSource="{d:SampleData ItemCount=5}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="LightPink" BorderThickness="1" CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontSize="22" Text="{Binding ID, StringFormat=Заказ {0}}" Margin="0 0 10 0"/>
                                        <TextBlock FontSize="22" Text="{Binding Date, StringFormat=От {0}}" Margin="0 0 10 0"/>
                                        <TextBlock FontSize="22" Text="{Binding User.FirstName, StringFormat=Клиент: {0}}" Margin="0 0 10 0"/>
                                        <TextBlock FontSize="22" Text="{Binding DeliverDate, StringFormat=Дата получения: {0}}" Margin="0 0 10 0"/>
                                        <TextBlock Text="{Binding IsClosed, StringFormat=Статус: {0}}"/>
                                    </StackPanel>

                                    <Button Visibility="{Binding VisIsClosed}" Grid.Column="1" x:Name="BtnCloseOrder" Content="Закрыть заказ" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10 0 10 0" Click="BtnCloseOrder_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <TabItem Header="Товары" FontSize="22">
                <ListBox x:Name="ListBoxProduct" d:ItemsSource="{d:SampleData ItemCount=5}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="LightPink" BorderThickness="1" CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0" Height="180" Width="180" Margin="0 0 10 0" Source="{Binding Image}"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}"/>
                                        <TextBlock Text="{Binding PriceWithDiscount, StringFormat=Цена со скидкой: {0}}"/>
                                        <TextBlock Text="{Binding Discount, StringFormat='Скидка: {0}' }"/>
                                        <TextBlock Text="{Binding Manufacturer.Name, StringFormat=Производитель: {0}}"/>
                                        <TextBlock Text="{Binding ProdCategory.Name, StringFormat=Категория: {0}}"/>
                                        <TextBlock Text="{Binding Description, StringFormat=Описание: {0}}"/>
                                        <TextBlock Text="{Binding Rating, StringFormat=Рейтинг: {0}}"/>

                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20">
                                        <Button Content="Изменить товар" Click="BtnChangeProduct_Click"/>
                                        <Button Content="{Binding ButtonContenFrozen}" Margin="0 10 0 0" Click="BtnFrozeProduct_Click"/>

                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <TabItem Header="Производители">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="BtnAddManufacturer" Content="Добавить производителя" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Row="0" Margin="10" Click="BtnAddManufacturer_Click"/>

                    <ListBox x:Name="ListBoxManufacturers"  Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="LightPink" BorderThickness="1" CornerRadius="5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Margin="10"/>
                                        <Button x:Name="BtnChangeMan" Content="Изменить" Height="30" Margin="10" Click="BtnChangeMan_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="Типы товаров" FontSize="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="BtnAddProdCat" Content="Добавить тип товара" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Row="0" Margin="10" Click="BtnAddProdCat_Click"/>

                    <ListBox x:Name="ListBoxProdCateg" Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="LightPink" BorderThickness="1" CornerRadius="5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Margin="10"/>
                                        <Button x:Name="BtnChangeProdCat" Content="Изменить" Height="30" Margin="10" Click="BtnChangeProdCat_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="Типы услуг">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="BtnAddServCat" Content="Добавить тип услуги" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Row="0" Margin="10" Click="BtnAddServCat_Click"/>

                    <ListBox x:Name="ListBoxServCat" Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="LightPink" BorderThickness="1" CornerRadius="5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Margin="10"/>
                                        <Button x:Name="BtnChangeServCat" Content="Изменить" Height="30" Margin="10" Click="BtnChangeServCat_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
