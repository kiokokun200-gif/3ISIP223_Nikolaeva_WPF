<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._2PageCatalog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="1000"
      Title="_2PageCatalog">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="10">
            <TextBlock Text="⌕" FontSize="25"/>
            <TextBox x:Name="TxtBoxSearch" Width="200" Margin="0 0 10 0" TextChanged="TxtBoxSearch_TextChanged"/>
            <TextBlock Text="Сортировка" FontSize="20" Margin="0 0 10 0"/>
            <ComboBox x:Name="ComboBoxSort" Width="200" Margin="0 0 10 0" SelectedIndex="0" SelectionChanged="ComboBoxSort_SelectionChanged" />
            <TextBlock Text="Фильтрация по жанрам" Margin="0 0 10 0" FontSize="20"/>
            <ComboBox x:Name="ComboBoxFiltrGenre" Width="200" SelectedIndex="0" SelectionChanged="ComboBoxSort_SelectionChanged"/>
        </StackPanel>

        <ListBox Grid.Row="1" x:Name="ListBoxBooks" d:ItemsSource="{d:SampleData ItemCount=5}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="ListBoxBooks_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="10 0 0 0">
                        <Grid>
                            
                            <Image Source="{Binding CoverImage}" Width="200" Height="350"/>
                            <Border Background="#FFFF9AC8" Width="40" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="{Binding AvgRating, StringFormat={}★{0:F0}}"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="{Binding User.NickName, StringFormat=Автор: {0}}" FontSize="15"/>
                        <TextBlock Text="{Binding GenresString, StringFormat=Жанры: {0}}"/>
                        <Button x:Name="BtnAddToList" Content="Добавить в список"  Width="200" Height="40" Style="{StaticResource BtnsPikmi}" FontSize="15" Click="BtnAddToList_Click"/>

                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
