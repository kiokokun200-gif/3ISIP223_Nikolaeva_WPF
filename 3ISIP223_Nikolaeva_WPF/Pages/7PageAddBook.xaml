<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._7PageAddBook"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="800"
      Title="_7PageAddBook">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Добавление книги" FontSize="30" FontWeight="Bold" Margin="10" />
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="10">
            <TextBlock Text="Название: "/>
            <TextBox x:Name="TxtBoxName" Margin="0 0 10 15"/>

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="Жанры:" Margin="0 0 10 0"/>
            </StackPanel>
            <ListBox x:Name="ListBoxGenres" d:ItemsSource="{d:SampleData ItemCount=5}" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>


                            <CheckBox Grid.Column="0" Content="{Binding Name}" Click="CheckBox_Click"/>
                           
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>


            

        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10 0">
            <TextBlock Text="Описание:"/>
            <TextBox x:Name="TxtBoxDescription" Height="80" TextWrapping="Wrap" Margin="0 0 10 15"  HorizontalContentAlignment="Stretch" Width="500"/>


            <TextBlock Text="Путь к обложке:"/>
            <TextBox x:Name="TxtBoxImagePath" Margin="0 0 10 15" Width="500"/>

            <TextBlock Text="Текст: "/>
            <TextBox x:Name="TxtBoxText" Width="500" Height="150" ScrollViewer.VerticalScrollBarVisibility="Visible"/>
        </StackPanel>
        <Button x:Name="BtnAdd" Content="Добавить" Style="{StaticResource BtnsPikmi}" Grid.ColumnSpan="2" Grid.Row="2" Width="200" Click="BtnAdd_Click"/>
    </Grid>
</Page>
