<Window x:Class="_3ISIP223_Nikolaeva_WPF.Pages.WindowChangePassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
        mc:Ignorable="d"
        Title="WindowChangePassword" Height="250" Width="400">
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="{Binding NickName, StringFormat= Смена пароля для {0}}"/>
            <TextBox Text="{Binding Password}" x:Name="TxtBoxPasswoed"/>
            <Button x:Name="BtnSave" Content="Сохранить" Style="{StaticResource BtnsPikmi}" Width="200" HorizontalAlignment="Left" Click="BtnSave_Click"/>
            
        </StackPanel>
    </Grid>
</Window>
