<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._3PageLogin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_3PageLogin">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Left" Orientation="Horizontal">
            <Button x:Name="BtnLogin" Content="Вход" Height="30" Width="100" FontWeight="Bold" Background="White" BorderThickness="0"/>
            <Button x:Name="BtnRegister" Content="Регистрация" Height="30" Width="100" Background="White" BorderThickness="0" Click="BtnRegister_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center">
            <TextBlock Text="ВХОД" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Email"/>
            <TextBox x:Name="TxtBoxEmail" Width="300" Height="30" TextChanged="TxtBoxEmail_TextChanged"/>
            <TextBlock Text="Пароль"/>
            <TextBox x:Name="TxtBoxPassword" Width="300" Height="30" TextChanged="TxtBoxPassword_TextChanged"/>
            <Button x:Name="BtnLoginBD" Content="Войти" Width="150" Height="30" Margin="20" Background="#FFFF37B5" Foreground="White" FontSize="20" IsEnabled="False" Click="BtnLoginBD_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Page>
