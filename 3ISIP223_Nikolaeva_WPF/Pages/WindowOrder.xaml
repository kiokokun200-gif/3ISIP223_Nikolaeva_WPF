<Window x:Class="_3ISIP223_Nikolaeva_WPF.Pages.WindowOrder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
        mc:Ignorable="d"
        Title="WindowOrder" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <TextBlock Text="Подтверждение заказа" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="Выберите дату получения" FontSize="22" Margin="0 10 0 0"/>
            <ListBox x:Name="ListBoxDates">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button x:Name="BtnDate" Content="{Binding Date}" Width="100" Height="30"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <TextBlock Text="Выберите способ оплаты:"/>
        </StackPanel>
    </Grid>
</Window>
