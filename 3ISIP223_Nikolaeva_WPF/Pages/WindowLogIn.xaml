<Window x:Class="_3ISIP223_Nikolaeva_WPF.Pages.WindowLogIn"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
        mc:Ignorable="d"
        Title="WindowLogIn" Height="250" Width="300"
        WindowStartupLocation="CenterOwner">
    <Grid Background="White">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Выберите роль для входа" FontSize="20" Margin="0 0 0 10"/>
            <ComboBox x:Name="ComboBoxRoles" Width="150" SelectedIndex="1" SelectionChanged="ComboBoxRoles_SelectionChanged"/>
        </StackPanel>
    </Grid>
</Window>
