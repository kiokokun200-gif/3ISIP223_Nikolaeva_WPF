<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._1StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_1StartPage">

    <Grid Background="White">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="РОГАЛИК" FontSize="60" />
            <Button x:Name="BtnStart" Content="Начать игру" BorderThickness="0" Background="#FF52BBFF" FontSize="30" Width="200" Margin="0 10 0 10" Click="BtnStart_Click"/>
            <Button x:Name="BtnExit" Content="Выйти" BorderThickness="0" Background="#FFF26767" FontSize="30" Width="100" Click="BtnExit_Click" />
        </StackPanel>
    </Grid>
</Page>
