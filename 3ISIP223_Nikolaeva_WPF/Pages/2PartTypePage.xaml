<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._2PartTypePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_2PartTypePage">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="⌕" FontSize="30"/>
            <TextBox x:Name="TxtBoxSearch" Width="200" Height="30" FontSize="20" TextChanged="TxtBoxSearch_TextChanged"/>
            <ComboBox x:Name="ComboManufactured" Width="100" SelectedIndex="0" FontSize="18" Height="30" Margin="10 0" BorderThickness="0" SelectionChanged="ComboManufactured_SelectionChanged"/>
        </StackPanel>

        <ListBox x:Name="PartsListBox" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" d:ItemsSource="{d:SampleData ItemCount=5}" >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!--<WrapPanel Orientation="Horizontal">
                        <Image Source="{Binding image}" Width="150" Height="150" Margin="10"/>
                        <WrapPanel>
                        <TextBlock Text="{Binding name}" Margin="10" FontSize="22" />
                        <TextBlock Text="{Binding FullDescription, StringFormat=[{0}]}" Margin="10" FontSize="22" TextWrapping="Wrap"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding price}"  FontSize="30"/>
                    </WrapPanel>-->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>

                        
                        <Image Grid.Column="0" Source="{Binding image}" Width="150" Height="150" Margin="10"/>
                        <WrapPanel Grid.Column="1">
                            <TextBlock Text="{Binding name}" Margin="0 10 10 0" FontSize="22" />
                            <TextBlock Text="{Binding FullDescription, StringFormat=[{0}]}" Margin="0 10" FontSize="22" TextWrapping="WrapWithOverflow"/>
                          
                        </WrapPanel>
                        <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding price, StringFormat='{}{0:F2} $'}" FontSize="30" />
                            <Button x:Name="BtnAddPart" Content="Добавить" Background="#FFFF3394" Height="30" Width="100" FontSize="15" BorderThickness="0" Foreground="White" Click="BtnAddPart_Click"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
        
            </ListBox.ItemTemplate>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
        
        <Button x:Name="BtnBack" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" FontSize="20" Width="100" Height="30" Content="Назад" Background="#FFFF3394" BorderThickness="0" Foreground="White" Click="BtnBack_Click"/>

    </Grid>
</Page>
