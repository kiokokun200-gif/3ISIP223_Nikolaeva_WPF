<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._2PartTypePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_2PartTypePage">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="⌕" FontSize="30"/>
            <TextBox Width="200" Height="30"/>
        
        </StackPanel>

        <ListBox x:Name="PartsListBox" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <WrapPanel Orientation="Horizontal">
                        <Image Source="{Binding image}" Width="150" Height="150" Margin="10"/>
                        <WrapPanel>
                        <TextBlock Text="{Binding name}" Margin="10" FontSize="22" />
                        <TextBlock Text="{Binding FullDescription, StringFormat=[{0}]}" Margin="10" FontSize="22" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding price}"  FontSize="30"/>
                        </WrapPanel>
                    </WrapPanel>
                </DataTemplate>
        
            </ListBox.ItemTemplate>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
        
    </Grid>
</Page>
