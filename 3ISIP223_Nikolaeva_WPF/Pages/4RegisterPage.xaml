<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._4RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_4RegisterPage">

    <Grid Background="White">
        <Grid Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Left" Orientation="Horizontal">
                <Button x:Name="BtnLogin" Content="Вход" Height="30" Width="100" Background="White" BorderThickness="0" Click="BtnLogin_Click"/>
                <Button x:Name="BtnRegister" Content="Регистрация" Height="30" Width="100" FontWeight="Bold" Background="White" BorderThickness="0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                <TextBlock Text="РЕГИСТРАЦИЯ" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Имя"/>
                <TextBox x:Name="TxtBoxName" Width="300" Height="30" TextChanged="Register_TextChanged"/>
                <TextBlock Text="Email"/>
                <TextBox x:Name="TxtBoxEmail" Width="300" Height="30" TextChanged="Register_TextChanged"/>
                <TextBlock Text="Пароль"/>
                <TextBox x:Name="TxtBoxPassword" Width="300" Height="30" TextChanged="Register_TextChanged"/>
                <TextBlock Text="Подтвердите пароль"/>
                <TextBox x:Name="TxtBoxConfirmPassword" Width="300" Height="30" TextChanged="Register_TextChanged"/>
                <Button x:Name="BtnRegisterBD" Content="Зарегистрироваться" Width="150" Height="30" Margin="20" Background="#FFFF37B5" Foreground="White" IsEnabled="False" FontSize="20" Click="BtnRegisterBD_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
