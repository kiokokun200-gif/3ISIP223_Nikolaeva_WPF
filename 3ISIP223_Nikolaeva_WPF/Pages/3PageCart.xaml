<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._3PageCart"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_3PageCart">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="корзина /" FontSize="40" FontWeight="Bold"/>
            <TextBlock x:Name="TxtBlockCartQuantity" FontSize="35"/>
            <TextBlock x:Name="TxtBlockEmptyCart" Text="Корзина пуста" 
                       FontSize="24" Foreground="Gray" Margin="20,0,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>

        <ListBox Grid.Row="1" x:Name="ListBoxProductsInCart" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="{Binding Image}" Width="80" Height="80" Grid.Column="0"/>

                            <StackPanel Grid.Column="1" Margin="15,0">
                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Price, StringFormat={}{0:F2} ₽}" FontSize="16" Foreground="Gray"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnMinusProd" Content="-" Width="30" Height="30" FontSize="20" Click="BtnMinusProd_Click"/>
                                <TextBlock Text="{Binding Quantity}" FontSize="20" Width="40" TextAlignment="Center"/>
                                <Button x:Name="BtnPlusProd" Content="+" Width="30" Height="30" FontSize="20" Click="BtnPlusProd_Click"/>
                                <Button x:Name="BtnDeleteProd" Content="🗑️" Width="40" Height="30" Margin="10,0,0,0" Click="BtnDeleteProd_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>