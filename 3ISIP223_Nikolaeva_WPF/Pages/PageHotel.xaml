<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages.PageHotel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageHotel">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            
        </Grid.ColumnDefinitions>

        <Image Source="{Binding Image}" Grid.Column="0" Width="200"/>
        <StackPanel Grid.Column="1" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Name}"/>
            <TextBlock Text="{Binding Description }"/>
            <TextBlock Text="{Binding Address}"/>

            <Button Width="200" x:Name="BtnAddReview" Content="Оставить отзыв" Click="BtnAddReview_Click"/>

            <!--<ComboBox x:Name="ComboBoxCategory" />-->
        </StackPanel>
        
        
        
    </Grid>
</Page>
