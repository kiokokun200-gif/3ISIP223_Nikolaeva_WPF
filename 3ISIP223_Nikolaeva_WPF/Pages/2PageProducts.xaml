<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._2PageProducts"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_2PageProducts">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Top">
            <TextBlock Text="⌕" FontSize="30" Margin="10"/>
            <TextBox x:Name="TxtBoxSearch" Width="150" Height="40" FontSize="20" TextChanged="TxtBoxSearch_TextChanged"/>

            <ComboBox x:Name="ComboBoxFiltrProdCat" Style="{StaticResource FiltrCombo}" Margin="10 0 0 0" SelectedIndex="0" SelectionChanged="ComboBoxFiltrProdCat_SelectionChanged"/>
            <ComboBox x:Name="ComboBoxFiltrProdMan" Style="{StaticResource FiltrCombo}" Margin="10 0 0 0" SelectedIndex="0" SelectionChanged="ComboBoxFiltrProdCat_SelectionChanged"/>
            <Button x:Name="BtnSortRating" Content="Сортировка по рейтингу" Background="White" Foreground="Black" FontSize="20" Height="40" Margin="10 0 0 0" Click="BtnSortRating_Click"/>
        </StackPanel>
        
        
        
        <ListBox x:Name="ListBoxProducts" Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}" MouseDown="ListBoxProducts_MouseDown" MouseDoubleClick="ListBoxProducts_MouseDown">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border>
                        <StackPanel HorizontalAlignment="Center">
                            <Grid>
                                <Image Source="{Binding Image}" Width="150"  Height="150"/>
                                <TextBlock Text="{Binding Rating}" HorizontalAlignment="Right"  FontSize="18" />
                                <Border Visibility="{Binding DiscountVisibility}" Background="#FFEE1C99" Width="39" Height="25" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Discount, StringFormat={}{0}%}" HorizontalAlignment="Left" FontSize="18"/>
                                    
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding Name}"/>
                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="{Binding PriceWithDiscount, StringFormat={}{0:F2} P}" Margin="0 0 10 0" />
                                <TextBlock Visibility="{Binding DiscountVisibility}" Text="{Binding Cost, StringFormat={}{0} P}" TextDecorations="StrikeThrough" Foreground="Gray"/>
                            </StackPanel>
                            <Button x:Name="BtnAddCart" Content="Добавить в корзину" Click="BtnAddCart_Click"/>
                        
                        </StackPanel>
                        
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDiscountMore15}" Value="true">
                                        <Setter Property="Background" Value="LightGreen"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>


                        </Border.Style>
                    </Border>
                    
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel></WrapPanel>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
        

        <Button x:Name="BtnCart" Grid.Row="1" Height="50" Width="70" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="BtnCart_Click">
            <Image Source="/Images/cart.png"/>
        </Button>
    </Grid>
</Page>
