<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._1PageMain"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_1PageMain">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock  Text="Фильтр по услуге" Margin="10" FontSize="18"/>
            <ComboBox Style="{StaticResource FiltrCombo}" x:Name="ComboBoxServices" Background="Red"/>
            <TextBlock Text="Фильтр по мастеру" FontSize="18" Margin="10"/>
            <ComboBox Style="{StaticResource FiltrCombo}" x:Name="ComboBoxMasters"/>
        </StackPanel>

        <Button x:Name="BtnLogin" Grid.Row="0" Content="Войти в аккаунт" HorizontalAlignment="Right" FontSize="15" Click="BtnLogin_Click"/>
       
    </Grid>
</Page>
