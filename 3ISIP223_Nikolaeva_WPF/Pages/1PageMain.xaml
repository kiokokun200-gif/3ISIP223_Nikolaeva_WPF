<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._1PageMain"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_1PageMain">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="#FFFFC1C1" HorizontalAlignment="Left">
            <!--<TextBlock Text="Меню" FontSize="20" Margin="0 0 0 10"/>-->
            <Button x:Name="BtnCatalogBook" Style="{StaticResource BtnsMenu}" ToolTip="Каталог книг" Click="BtnCatalogBook_Click">
                <Image Source="/Images/Icons/BookCatalog.png" Width="40"/>
            </Button>
            <Button x:Name="BtnListBook" Style="{StaticResource BtnsMenu}" ToolTip="Списки книг" Click="BtnListBook_Click">
                <Image Source="/Images/Icons/BookList.png" Width="40"/>
            </Button>
            <Button x:Name="BtnAdmin" Style="{StaticResource BtnsMenu}" ToolTip="Администрирование " Visibility="{Binding VisIsAdmin}" Click="BtnAdmin_Click">
                <Image Source="/Images/Icons/Admin.png" Width="40"/>
            </Button>
            <Button x:Name="BtnAuthor" Style="{StaticResource BtnsMenu}" ToolTip="Автор " Visibility="{Binding VisIsAuthor}" Click="BtnAuthor_Click">
                <Image Source="/Images/Icons/Author.png" Width="40"/>
            </Button>
            <Button x:Name="BtnFroze" Style="{StaticResource BtnsMenu}" ToolTip="Предупреждение о заморозке аккаунта" Visibility="{Binding VisIsFrozen}" >
                <Image Source="/Images/Icons/ProfileFroze.png" Width="35"/>
            </Button>
            <Button x:Name="BtnProfile" Style="{StaticResource BtnsMenu}" Visibility="{Binding VisIsUserAuthor}" ToolTip="Профиль" Click="BtnProfile_Click">
                <Image Source="/Images/Icons/Profile.png" Width="40"/>
            </Button>
        </StackPanel>

        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden" Source="/Pages/2PageCatalog.xaml"/>
    </Grid>
</Page>
