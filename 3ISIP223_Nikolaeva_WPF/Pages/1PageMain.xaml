<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._1PageMain"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_1PageMain">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="#FFFFC1C1" HorizontalAlignment="Left">
            <TextBlock Text="Меню" FontSize="20" Margin="0 0 0 10"/>
            <Button x:Name="BtnCatalogBook" Style="{StaticResource BtnsMenu}" Content="Каталог книг" Click="BtnCatalogBook_Click"/>
            <Button x:Name="BtnListBook" Style="{StaticResource BtnsMenu}" Content="Списки книг" Click="BtnListBook_Click"/>
            <Button x:Name="BtnAdmin" Style="{StaticResource BtnsMenu}" Content="Администрирование " Click="BtnAdmin_Click"/>
            <Button x:Name="BtnAuthor" Style="{StaticResource BtnsMenu}" Content="Заморозка" Click="BtnAuthor_Click"/>
            <Button x:Name="BtnProfile" Style="{StaticResource BtnsMenu}" Content="Профиль" Click="BtnProfile_Click"/>
        </StackPanel>

        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden" Source="/Pages/2PageCatalog.xaml"/>
    </Grid>
</Page>
