<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._1PageMain"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="900"
      Title="_1PageMain">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock  Text="Фильтр по услуге" Margin="10" FontSize="18"/>
            <ComboBox Style="{StaticResource FiltrCombo}" x:Name="ComboBoxServices" SelectionChanged="ComboBoxServices_SelectionChanged"/>
            <TextBlock Text="Фильтр по мастеру" FontSize="18" Margin="10"/>
            <ComboBox Style="{StaticResource FiltrCombo}" x:Name="ComboBoxMasters" SelectionChanged="ComboBoxServices_SelectionChanged"/>
            <Button x:Name="BtnProduct" Content="Товары" Background="White" Foreground="Black" FontSize="18" Margin="10 0 0 0" Click="BtnProduct_Click"/>
        </StackPanel>

        <Button x:Name="BtnLogin" Grid.Row="0" Content="Войти в аккаунт"  HorizontalAlignment="Right" FontSize="15" Click="BtnLogin_Click"/>

        <ListBox Grid.Row="1" x:Name="ListBoxServicesTypes" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" >
                        <TextBlock FontSize="25" Text="{Binding Name}"/>
                        <TextBlock Text="{Binding Description}" FontSize="18"/>
                        <Button x:Name="BtnServiceGo" Content="Перейти" Width="80" FontSize="18" Click="BtnServiceGo_Click"/>

                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

    </Grid>
</Page>
