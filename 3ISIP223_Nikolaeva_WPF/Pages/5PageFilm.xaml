<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._5PageFilm"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_5PageFilm">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Image Grid.Column="0" Grid.RowSpan="2" Source="{Binding Cover}" Height="400" Width="300"/>
        <StackPanel Grid.Column="1" Grid.Row="0">
            <TextBlock Text="{Binding Name}" FontSize="40"/>
            <TextBlock x:Name="TxtBoxGenres"/> <!--спросить-->
            <TextBlock Text="{Binding Rating, StringFormat=Рейтинг: {0}}"/>
            <TextBlock Text="{Binding Description, StringFormat=Описание: {0}}"/>
            
        </StackPanel>
        <StackPanel x:Name="First" Grid.Row="1" Grid.Column="1">
            <TextBlock Text="Сеансы:"/>
            <ListBox Grid.Row="1" x:Name="SeansListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <WrapPanel Orientation="Vertical">
                            <StackPanel Orientation="Vertical">
                                <Button x:Name="BtnSeans" Content= "{Binding SeansDate}" FontSize="10" Click="BtnSeans_Click"/>
                                <TextBlock Text="{Binding Kinozal.Kinozal_Rating.Name}"/>
                                <TextBlock Text="{Binding Kinozal.Kinozal_Rating.Ticket_Price}"/>
                            </StackPanel>
                        </WrapPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </StackPanel>
        <Button Grid.Row="1" x:Name="BtnBack" Content="Назад" Height="20" Width="40" VerticalAlignment="Bottom" HorizontalAlignment="Left" Click="BtnBack_Click"/>
    </Grid>
</Page>
