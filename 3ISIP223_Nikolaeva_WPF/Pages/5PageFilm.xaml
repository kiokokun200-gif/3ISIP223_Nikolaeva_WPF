<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._5PageFilm"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_5PageFilm">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0" Source="{Binding Cover}" Height="400" Width="300"/>
        <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Name}" FontSize="40"/>
            <TextBlock Text="{Binding Genre, StringFormat=Жанр: {0}}"/> <!--спросить-->
            <TextBlock Text="{Binding Rating, StringFormat=Рейтинг: {0}}"/>
            <TextBlock Text="{Binding Description, StringFormat=Описание: {0}}"/>
        </StackPanel>
    </Grid>
</Page>
