<Window x:Class="_3ISIP223_Nikolaeva_WPF.Pages.WindowProduct"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
        mc:Ignorable="d"
        Title="WindowProduct" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0 0 30 0">
            <TextBlock Text="{Binding Rating}" FontSize="30" HorizontalAlignment="Right"/>
            <Image Grid.Column="0" VerticalAlignment="Center" Height="300" Width="300" Source="{Binding Image}"/>
            <Border Visibility="{Binding DiscountVisibility}" Background="#FFEE1C99" Width="39" Height="25" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="{Binding Discount, StringFormat={}{0}%}" HorizontalAlignment="Left" FontSize="18"/>
                
            </Border>
        </Grid>


        <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Name}" FontSize="30"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding PriceWithDiscount, StringFormat={}{0:F2} P}" Margin="0 0 10 0" />
                <TextBlock Visibility="{Binding DiscountVisibility}" Text="{Binding Cost, StringFormat={}{0} P}" TextDecorations="StrikeThrough" Foreground="Gray"/>
            </StackPanel>
            <TextBlock Text="{Binding ProdCategory.Name, StringFormat=Категория: {0}}" FontSize="20"/>
            <TextBlock Text="{Binding Manufacturer.Name, StringFormat=Производитель: {9}}" FontSize="20"/>
            <TextBlock Text="{Binding Description}" FontSize="15"/>
            
        </StackPanel>
    </Grid>
</Window>
