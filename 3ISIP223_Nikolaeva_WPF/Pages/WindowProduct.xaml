<Window x:Class="_3ISIP223_Nikolaeva_WPF.Pages.WindowProduct"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
        mc:Ignorable="d"
        Title="WindowProduct" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="{Binding Rating}" FontSize="30"/>
        <Image Grid.Column="0" VerticalAlignment="Center" Height="300" Width="300" Source="{Binding Image}"/>

        <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Name}" FontSize="30"/>
            <TextBlock Text="{Binding Cost, StringFormat={}{0} Р}" FontSize="20"/>
            <TextBlock Text="{Binding ProdCategory.Name, StringFormat=Категория: {0}}" FontSize="20"/>
            <TextBlock Text="{Binding Description}" FontSize="15"/>
            
        </StackPanel>
    </Grid>
</Window>
