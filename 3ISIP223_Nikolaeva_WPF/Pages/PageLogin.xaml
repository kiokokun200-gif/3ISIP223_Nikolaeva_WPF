<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages.PageLogin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageLogin">

    <Grid Background="White">
        <TabControl x:Name="TabControlClient" Visibility="Visible">
            <TabItem Header="ВХОД" FontSize="20">
                <StackPanel x:Name="StackClient" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Top">


                    <StackPanel x:Name="StackClientLogin" Visibility="Visible" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Логин" Margin="0 0 10 0" FontSize="18"/>
                            <TextBox x:Name="TxtBoxLogLogin" Width="150" FontSize="18" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                            <TextBlock Text="Пароль" Margin="0 0 10 0" FontSize="18"/>
                            <PasswordBox x:Name="TxtBoxLogPassword" Width="150" FontSize="18"/>
                        </StackPanel>

                        <Button x:Name="BtnClientLogLog" Style="{StaticResource BtnsPikmi}" Content="Войти" Width="100" FontSize="20" Margin="0 10 0 0" HorizontalAlignment="Center" Click="BtnClientLogLog_Click"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="РЕГИСТРАЦИЯ" FontSize="20">

                <StackPanel x:Name="StackClientReg" Visibility="Visible" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 5">
                        <TextBlock Text="Ник" Margin="0 0 10 0" FontSize="18"/>
                        <TextBox x:Name="TxtBoxNickName" Width="150" FontSize="18"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 0 0 5">
                        <TextBlock Text="Логин" Margin="0 0 10 0" FontSize="18"/>
                        <TextBox x:Name="TxtBoxLogin" Width="150" FontSize="18"/>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 0 0 5">
                        <TextBlock Text="Email" Margin="0 0 10 0" FontSize="18"/>
                        <TextBox x:Name="TxtBoxEmail" Width="150" FontSize="18"/>
                    </StackPanel>

                    

                    <StackPanel Orientation="Horizontal" Margin="0 0 0 5">
                        <TextBlock Text="Пароль" Margin="0 0 10 0" FontSize="18"/>
                        <PasswordBox x:Name="TxtBoxRegPassword" Width="150" FontSize="18"/>
                    </StackPanel>

                    <Button x:Name="BtnClientRegReg" Content="Зарегистрироваться" Style="{StaticResource BtnsPikmi}" Width="200" FontSize="20" Margin="0 10 0 0" HorizontalAlignment="Center" Click="BtnClientRegReg_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
