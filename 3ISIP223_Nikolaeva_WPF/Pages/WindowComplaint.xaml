<Window x:Class="_3ISIP223_Nikolaeva_WPF.Pages.WindowComplaint"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
        mc:Ignorable="d"
        Title="WindowComplaint" Height="450" Width="400">
    <Grid>
        <StackPanel>
            <TextBlock x:Name="TxtBlcComplaintTarget" HorizontalAlignment="Center" FontSize="22"/>
            <ListBox x:Name="ListBoxReasons" d:ItemsSource="{d:SampleData ItemCount=5}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <RadioButton Content="{Binding Name}" GroupName="Radio" Checked="RadioButton_Checked"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                
            </ListBox>

            <Button x:Name="BtnComplaint" Content="Пожаловаться" Style="{StaticResource BtnsMenu}" Margin="10 10 0 0" Click="BtnComplaint_Click" />
        </StackPanel>
    </Grid>
</Window>
