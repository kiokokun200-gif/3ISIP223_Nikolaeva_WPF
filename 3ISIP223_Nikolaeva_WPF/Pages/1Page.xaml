<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._1Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_1Page">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="⌕" FontSize="20"></TextBlock>
            <TextBox x:Name="TxtBoxSearch" Width="300" TextChanged="TxtBoxSearch_TextChanged"/>
            <Button x:Name="BtnSortName" Click="Button_Click"/>
            <Button x:Name="BtnSortRating" Click="BtnSortRating_Click"/>
        </StackPanel>
        <Button Grid.Row="0" x:Name="ProfileBtn" HorizontalAlignment="Right" Content="Личная страница" Background="#FFFF37B5" Foreground="White" Click="ProfileBtn_Click"/>
        <ListBox Grid.Row="1" x:Name="FilmListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" MouseDoubleClick="FilmListBox_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <WrapPanel Orientation="Vertical" >
                        <Image Source="{Binding Cover}" Width="150" Height="200"/>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text= "{Binding Name}" FontSize="30"/>
                            <TextBlock Text="{Binding Rating, StringFormat=Рейтинг: {0}}"/>
                            <TextBlock Text="{Binding Age_Rating.Name, StringFormat=Возрастное ограничение: {0}}"/>
                            <TextBlock Text="{Binding ShowDate, StringFormat=Дата начала показа: {0}}"/>
                        </StackPanel>
                    </WrapPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
