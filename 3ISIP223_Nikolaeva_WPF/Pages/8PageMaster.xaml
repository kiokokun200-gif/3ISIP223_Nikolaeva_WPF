<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._8PageMaster"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_8PageMaster">


    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFF0F0F0" Padding="10">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding Image}" Width="80" Height="80" />
                <StackPanel Margin="15,0,0,0">
                    <TextBlock Text="{Binding FirstName}" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="{Binding LastName}" FontSize="20" Foreground="Gray"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="10">
            <TabItem Header="Мои записи" FontSize="20">
                <ListBox x:Name="ListBoxAppointments" Margin="5" d:ItemsSource="{d:SampleData ItemCount=5}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="LightPink" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Service.Name}" FontSize="22" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding User.FirstName, StringFormat=Клиент: {0}}" FontSize="18"/>
                                        <TextBlock Text="{Binding Date, StringFormat=Дата: {0:dd.MM.yyyy HH:mm}}" FontSize="16"/>
                                        <TextBlock Text="{Binding Status, StringFormat=Статус: {0}}" FontSize="16"/>
                                        <TextBlock Text="{Binding Comment, StringFormat=Комментарий: {0}}" FontSize="14" Foreground="Gray"/>
                                    </StackPanel>
                                    <Button Visibility="{Binding VisIsClosed}" Grid.Column="1" Content="Завершить" Width="150" Height="40"  Margin="10 0 0 0"
                                        Click="BtnCompleteAppointment_Click" Tag="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <TabItem Header="Мои услуги" FontSize="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="Добавить услугу" Width="200" Height="35" 
                        Margin="10" HorizontalAlignment="Left" Click="BtnAddService_Click"/>

                    <ListBox Grid.Row="1" x:Name="ListBoxServices" Margin="5" d:ItemsSource="{d:SampleData ItemCount=5}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="LightPink" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ServCategory.Name}" FontSize="22" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Price, StringFormat=Цена: {0} Р}" FontSize="18"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Удалить" Width="100" Height="30"  Margin="10 0 0 0"
                                            Click="BtnRemoveService_Click" Tag="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</Page>
