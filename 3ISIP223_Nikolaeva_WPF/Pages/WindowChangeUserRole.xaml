<Window x:Class="_3ISIP223_Nikolaeva_WPF.Pages.WindowChangeUserRole"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Редактирование пользователя" Height="700" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Background="White" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Редактирование пользователя" 
                   FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Панель с полями -->
        <StackPanel Grid.Row="1">
            <!-- Имя -->
            <TextBlock Text="Имя:" FontSize="16" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtBoxFirstName" FontSize="16" Height="35" Margin="0,0,0,15"/>

            <!-- Фамилия -->
            <TextBlock Text="Фамилия:" FontSize="16" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtBoxLastName" FontSize="16" Height="35" Margin="0,0,0,15"/>

            <!-- Отчество -->
            <TextBlock Text="Отчество:" FontSize="16" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtBoxMiddleName" FontSize="16" Height="35" Margin="0,0,0,15"/>

            <!-- Телефон -->
            <TextBlock Text="Телефон:" FontSize="16" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtBoxPhone" FontSize="16" Height="35" Margin="0,0,0,15"/>

            <!-- Пароль -->
            <TextBlock Text="Пароль:" FontSize="16" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtBoxPassword" FontSize="16" Height="35" Margin="0,0,0,15"/>

            <!-- Роль -->
            <TextBlock Text="Роль:" FontSize="16" Margin="0,0,0,5"/>
            <ComboBox x:Name="ComboBoxRoles" Height="35" FontSize="16" DisplayMemberPath="Name" Margin="0,0,0,10"/>

            <!-- Предупреждение -->
            <TextBlock x:Name="TextBlockWarning" FontSize="14" Foreground="Red" 
                       Visibility="Collapsed" Margin="0,0,0,15" TextWrapping="Wrap"/>

            <!-- Кнопки -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,10,0,0">
                <Button Content="Сохранить" Width="120" Height="35" Click="BtnSave_Click" Margin="0,0,10,0"/>
                <Button Content="Отмена" Width="100" Height="35" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>