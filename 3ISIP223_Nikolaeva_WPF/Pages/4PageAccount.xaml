<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._4PageAccount"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_4PageAccount">


    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="10">
            <TextBlock Text="{Binding LastName}" FontSize="30"/>
            <TextBlock Text=" " FontSize="30"/>
            <TextBlock Text="{Binding FirstName}" FontSize="30"/>
            <TextBlock Text=" " FontSize="30"/>
            <TextBlock Text="{Binding MiddleName}" FontSize="30"/>
        </StackPanel>
        <Button x:Name="BtnLogOut" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Width="100" Height="40" Content="Выйти" Click="BtnLogOut_Click"/>

        <TextBlock Grid.Row="1" Text="{Binding PhoneNumber}" FontSize="20" Margin="10"/>

        <TextBlock Grid.Row="2" Text="Ваши записи" FontSize="24" FontWeight="Bold" Margin="10"/>

        <ListBox Grid.Row="3" x:Name="ListBoxAppointments" Margin="10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
                        <StackPanel>
                            <TextBlock Text="{Binding Service.Name}" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Master.FirstName, StringFormat=Мастер: {0}}" FontSize="16"/>
                            <TextBlock Text="{Binding Date, StringFormat=Дата: {0:dd.MM.yyyy HH:mm}}" FontSize="16"/>
                            <TextBlock Text="{Binding Service.Price, StringFormat=Цена: {0} Р}" FontSize="16"/>
                            <TextBlock Text="{Binding Comment, StringFormat=Комментарий: {0}}" FontSize="14" Foreground="Gray"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel></WrapPanel>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <TextBlock Grid.Row="4" Text="Ваши заказы" FontSize="24" FontWeight="Bold" Margin="10"/>

        <ListBox Grid.Row="5" x:Name="ListBoxOrders" Margin="10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
                        <StackPanel>
                            <TextBlock Text="{Binding ID, StringFormat=Заказ №{0}}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Date, StringFormat=Дата заказа: {0:dd.MM.yyyy}}" FontSize="16"/>
                            <TextBlock Text="{Binding DeliverDate, StringFormat=Дата получения: {0:dd.MM.yyyy}}" FontSize="16"/>
                            <TextBlock Text="{Binding TotalAmount, StringFormat=Сумма: {0} Р}" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel></WrapPanel>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>

</Page>
