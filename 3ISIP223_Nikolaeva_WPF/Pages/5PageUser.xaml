<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._5PageUser"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_5PageUser">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel HorizontalAlignment="Left" Grid.Row="0" Grid.Column="0" Margin="10">
            <TextBlock Text="{Binding NickName}" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="{Binding Email, StringFormat=Email: {0}}" />
            <TextBlock Text="{Binding Login, StringFormat=Логин: {0}}"/>
            <TextBlock Text="{Binding Role.Name, StringFormat=Роль: {0}}"/>
         </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" >
            <!--<Button x:Name="BtnLogOut" Width="50" Height="50" Background="White" Click="BtnLogOut_Click" BorderThickness="0">
                <Image Source="/Images/Icons/LogOut.png"  />
                
            </Button>-->
            <Button x:Name="BtnAuthorRequest" Height="40" Visibility="{Binding IsAuthorRequest}" Content="Подать на автора" Style="{StaticResource BtnsMenu}" Click="BtnAuthorRequest_Click"/>
        </StackPanel>
        <Border Margin="10" Padding="5" Visibility="{Binding VisIsFrozen}" BorderBrush="Red" BorderThickness="1" CornerRadius="5" Grid.Row="1" Grid.ColumnSpan="2">
            <StackPanel>
                <TextBlock x:Name="TxtBlockFrozenUser" Text="{Binding ComplaintReason.Name, StringFormat={}⚠ Вы заморожены по причине {0}}"/>
                <Button x:Name="BtnDefrozeRequest" Visibility="{Binding IsDefrozingRequest}" Content="Подать заявку на разморозку" Style="{StaticResource BtnsPikmi}" Width="300" Click="BtnDefrozeRequest_Click"/>
            </StackPanel>
        </Border>
        <ListBox Grid.Row="2" x:Name="ListBoxReviews" Grid.ColumnSpan="2" d:ItemsSource="{d:SampleData ItemCount=5}" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="{Binding Date, StringFormat=dd MMMM yyyy}" FontSize="14"/>

                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock  HorizontalAlignment="Right" Text="{Binding Rating, StringFormat={}★{0}}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Text}"/>

                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
