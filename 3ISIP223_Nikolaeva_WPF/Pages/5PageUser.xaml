<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._5PageUser"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_5PageUser">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel HorizontalAlignment="Left" Grid.Row="0" Grid.Column="0" Margin="10">
            <TextBlock Text="{Binding NickName}" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="{Binding Email}" />
            <TextBlock Text="{Binding Login}"/>
            <TextBlock Text="{Binding Role.Name}"/>
         </StackPanel>

        <Button x:Name="BtnAuthorRequest" Height="40" HorizontalAlignment="Right" Content="Подать на автора" Style="{StaticResource BtnsMenu}" Grid.Column="1" Grid.Row="0" Click="BtnAuthorRequest_Click"/>
        <ListBox Grid.Row="1" x:Name="ListBoxReviews" Grid.ColumnSpan="2" d:ItemsSource="{d:SampleData ItemCount=5}" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="{Binding Date, StringFormat=dd MMMM yyyy}" FontSize="14"/>

                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock  HorizontalAlignment="Right" Text="{Binding Rating, StringFormat={}★{0}}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Text}"/>

                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
