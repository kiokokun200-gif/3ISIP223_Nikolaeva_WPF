<Window x:Class="_3ISIP223_Nikolaeva_WPF.Pages.WindowChangeAppointment"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
        mc:Ignorable="d"
        Title="WindowChangeAppointment" Height="550" Width="800">

    <Grid Background="White" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Текущая запись:" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <Border Grid.Row="1" BorderBrush="LightPink" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock x:Name="TxtBlockClient" FontSize="16"/>
                <TextBlock x:Name="TxtBlockService" FontSize="16"/>
                <TextBlock x:Name="TxtBlockMaster" FontSize="16"/>
                <TextBlock x:Name="TxtBlockDate" FontSize="16"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="Выберите новую дату:" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <DatePicker Grid.Row="3" x:Name="DatePickerNewDate" Height="35" FontSize="16" 
                    SelectedDateChanged="DatePickerNewDate_SelectedDateChanged" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="4" Text="Доступное время:" FontSize="16" Margin="0,0,0,5"/>

        <ListBox Grid.Row="5" x:Name="ListBoxSlots" Height="100" Margin="0,0,0,15" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding StartTime}" ContentStringFormat="HH:mm" Width="80" Height="35" Margin="5"
                            Click="BtnSlot_Click" Tag="{Binding}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Отмена" Width="100" Height="35" Click="BtnCancel_Click" Margin="0,0,10,0"/>
        </StackPanel>
    </Grid>
</Window>