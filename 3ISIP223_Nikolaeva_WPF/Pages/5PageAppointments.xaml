<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._5PageAppointments"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_5PageAppointments">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="LightPink" BorderThickness="1" CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="StackMaster">
                    
                    <Image x:Name="ImageMaster" Grid.Column="0" Source="{Binding Image}" Height="150" Width="150"/>
                    <TextBlock Text="{Binding FirstName}" FontSize="20" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" x:Name="StackService" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="22" Margin="0 0 0 10"/>
                    <TextBlock Text="{Binding Description}" FontSize="22"/>
                    
                </StackPanel> 
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10">
            <TextBlock  Text="Доступные записи: " FontSize="25" Margin="0 0 10 0"/>
            <DatePicker x:Name="Calendar" DisplayDate="2026-04-25" DisplayDateStart="2026-01-01" DisplayDateEnd="2026-12-31" IsTodayHighlighted ="True" 
                        
                       Width="200" DataContextChanged="Calendar_DataContextChanged"/>
        </StackPanel>
        <ListBox x:Name="ListBoxAppointments" Grid.Row="2" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Button x:Name="BtnAppointment" Width="100" Height="50" Content="{Binding StartTime}" Click="BtnAppointment_Click">
                        <!--<Button.Content>
                            <MultiBinding StringFormat="{}{0} - {1}">
                                <Binding Path="Schedule.StartTime" StringFormat="HH:mm"/>
                                <Binding Path="Schedule.EndTime" StringFormat="HH:mm"/>
                            </MultiBinding>
                        </Button.Content>-->
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

    </Grid>
</Page>
