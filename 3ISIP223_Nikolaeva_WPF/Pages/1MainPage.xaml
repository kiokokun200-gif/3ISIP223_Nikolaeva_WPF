<Page x:Class="_3ISIP223_Nikolaeva_WPF.Pages._1MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_1MainPage">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Column="0" Grid.Row="0" Text="Конфигуратор ПК" FontSize="25" HorizontalAlignment="Left"/>
        <Button x:Name="BtnAssembly" Grid.Row="0" Grid.Column="2" Content="Сборки" FontSize="20" Background="#FFFF3394" Foreground="White" BorderThickness="0" HorizontalAlignment="Right" Click="BtnAssembly_Click"/>
        <ListBox x:Name="PartTypesListBox" HorizontalContentAlignment="Stretch" Grid.Row="1" Width="400" Grid.ColumnSpan="2" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid >
                        <!--<Image x:Name="ImageBox" Source="{Binding picture}" Width="20" Height="20" Margin="10"/>-->
                        <TextBlock Text="{Binding name}" FontSize="20" Margin="10" HorizontalAlignment="Left"/>
                        <Button x:Name="BtnChoose" Content="Выбрать" FontSize="15" Margin="10" Background="#FFFF3394" Foreground="White" BorderThickness="0" Click="BtnChoose_Click" HorizontalAlignment="Right"/>
                        
                    </Grid>
                </DataTemplate>

            </ListBox.ItemTemplate>
            <!--<ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>-->
        </ListBox>
        <StackPanel Grid.Row="1" Grid.Column="2" >
        <TextBlock Text="Текущая сборка:" FontSize="20"/>
            <ListBox x:Name="CurrentAssemblyListBox" d:ItemsSource="{d:SampleData ItemCount=5}" MinHeight="25">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding parttype.name, StringFormat={}{0}:}" FontSize="15"/>
                            <TextBlock Text="{Binding name}" FontSize="15"/>
                            <TextBlock Text="{Binding FullDescription}" FontSize="15"/>
                            <TextBlock Text="{Binding price}" FontSize="15"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="Итоговая цена: " FontSize="20"/>
            <TextBlock x:Name="TxtBoxTotalAmount" FontSize="30"/>
            <Button x:Name="BtnSave" Content="Сохранить сборку" FontSize="20" Background="#FFFF3394" Foreground="White" BorderThickness="0" Click="BtnSave_Click"/>
            <TextBlock Text="Название сборки: " FontSize="15"/>
            <TextBox x:Name="TxtBoxAssemblyName" Width="200" Height="30" FontSize="15"/>
            <TextBlock Text="Автор:" FontSize="15"/>
            <TextBox x:Name="TxtBoxAssemblyAuthor" FontSize="15" Width="200" Height="30"/>
        </StackPanel>
    </Grid>
</Page>
