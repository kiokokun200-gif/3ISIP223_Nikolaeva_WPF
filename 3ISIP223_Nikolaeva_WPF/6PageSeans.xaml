<Page x:Class="_3ISIP223_Nikolaeva_WPF._6PageSeans"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_6PageSeans">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10">
            <TextBlock Text="{Binding Film.Name}" FontSize="30" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SeansDate, StringFormat=Дата: {0:dd.MM}}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding SeansDate, StringFormat=Время: {0:hh\\:mm}}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Kinozal.Name}"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Background="#FFC8C8C8" Text="Экран" Width="450" TextAlignment="Center" Height="20" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="1" x:Name="SeatsPanel" HorizontalAlignment="Center" Margin="20"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Width="20" Height="20" VerticalAlignment="Top" Background="LightGreen" />
            <TextBlock Text=" Свободно" Margin="0 0 10 0"/>
            <Button Width="20" Height="20" VerticalAlignment="Top" Background="Red"/>
            <TextBlock Text=" Занято" Margin="0 0 10 0"/>
            <Button Width="20" Height="20" VerticalAlignment="Top" Background="Orange"/>
            <TextBlock Text=" Выбранное вами" Margin="0 0 10 0"/>
            <TextBlock Text="{Binding Kinozal.Kinozal_Rating.Ticket_Price, StringFormat=Цена: {0}}"/>
        </StackPanel>



        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <CheckBox x:Name="HideBookedCheckBox" Content="Скрыть занятые места" Margin="0,0,20,0" Checked="HideBookedCheckBox_Checked" Unchecked="HideBookedCheckBox_Unchecked"/>
            <Button Content="Оформить билет" Click="BuyTicketButton_Click" Padding="20,10"/>
        </StackPanel>
        <Button Grid.Row="3" Content="Назад" Width="70" Height="30" HorizontalAlignment="Left" 
                Background="#FFFF37B5" Foreground="White" VerticalAlignment="Bottom" Click="Button_Click"/>
    </Grid>
</Page>
