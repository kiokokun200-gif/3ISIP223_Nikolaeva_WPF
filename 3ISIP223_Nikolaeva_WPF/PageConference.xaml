<Page x:Class="_3ISIP223_Nikolaeva_WPF.PageConference"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_Nikolaeva_WPF"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageConference">

    <Grid Background="White">
        <StackPanel>
            <TextBlock Text="{Binding Name, StringFormat=Регистрация на конференцию {0}}"/>
            <StackPanel x:Name="StackUserData" HorizontalAlignment="Left">
                <TextBlock Text="Логин"/>
                <TextBox x:Name="TxtBoxLogin" Width="200"/>
                <Button x:Name="BtnAutoZap" Content="Автозаполнение" Click="BtnAutoZap_Click"/>
                <TextBlock Text="Имя"/>
                <TextBox x:Name="TxtBoxUserName"/>
                <TextBlock Text="Организация"/>
                <TextBox x:Name="TxtBoxOrganization"/>
                <Button x:Name="BtnRegConference" Content="Зарегистрироваться" Click="BtnRegConference_Click"/>
                
                <TextBlock Text="Участники конференции: "/>
                <ListBox x:Name="ListBoxMembers" MouseDoubleClick="ListBoxMembers_MouseDoubleClick" d:ItemsSource="{d:SampleData ItemCount=5}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Username}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
